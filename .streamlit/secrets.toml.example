# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.
# Without an [anthropic] api_key the "Dịch tự động bằng AI" option is hidden and the app works as before.

[anthropic]
api_key = "sk-ant-..."
model = "claude-opus-5-5"     # optional
effort = "medium"             # optional: low | medium | high
batch_size = 25               # optional: items per API call
max_workers = 3               # optional: parallel calls
fallbacks = true              # optional: let the API retry a refused batch on another model
web_search = false            # optional: look up company international names on masothue.com / thuvienphapluat.vn ($10 per 1,000 searches)
web_search_max_uses = 20      # optional: max searches per lookup request (10 names per request)
enabled_users = []            # optional: e.g. ["admin", "phuong"]; empty = every signed-in user
